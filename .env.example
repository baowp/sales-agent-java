# Copy to .env and fill in ONE provider's key.
# Spring reads this file as Java properties: keep comments on their own lines
# (a "# comment" after a value becomes part of the value).
# Providers: groq | gemini | mistral | openrouter | glm | bailian | nvidia | ollama | custom
LLM_PROVIDER=groq

GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# glm: key from z.ai (or open.bigmodel.cn + LLM_BASE_URL)
# ZAI_API_KEY=
# bailian (阿里云百炼): key from bailian.console.aliyun.com -> API-KEY
# DASHSCOPE_API_KEY=
# NVIDIA_API_KEY=
# OLLAMA_API_KEY=

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# With LLM_PROVIDER=custom for a local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# MAX_STEPS=12
# REQUEST_TIMEOUT_SECONDS=120

# Web server port (the Node.js version uses 3001)
# PORT=3002

# SocksPal
# SOCKSPAL_API=https://api.sockspal.com/api/v1
# CATALOG_CACHE_SECONDS=60
# draft: save RFQs to ./rfqs for the sales team (default)
# submit: also POST them to SocksPal, which creates real RFQs
# RFQ_MODE=draft
