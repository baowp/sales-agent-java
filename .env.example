# Copy to .env and paste the API key for the provider you use.
# Only secrets belong here: everything else is in src/main/resources/application.yml,
# which reads these values as ${DASHSCOPE_API_KEY:} etc.
# Spring reads this file as Java properties: keep comments on their own lines.

# bailian (阿里云百炼, the default provider): key from bailian.console.aliyun.com -> API-KEY
DASHSCOPE_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# glm: key from z.ai (or open.bigmodel.cn)
# ZAI_API_KEY=
# NVIDIA_API_KEY=
# OLLAMA_API_KEY=

# Optional per-machine overrides of application.yml (the variable names it references):
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=http://localhost:11434/v1
# PORT=3002
# RFQ_MODE=draft
# LLM_EMBEDDING_MODEL=text-embedding-v4

# Turns on the sales-team chat search at http://localhost:3002/sales.html (any long random string).
# SALES_SEARCH_TOKEN=
